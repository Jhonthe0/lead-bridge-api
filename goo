#!/usr/bin/env bash
set -euo pipefail

command_name="${1:-help}"
shift || true

case "$command_name" in
  test)
    docker compose run --rm -e RAILS_ENV=test web bundle exec rspec "$@"
    ;;
  cop|rubocop)
    docker compose run --rm web bundle exec rubocop --config .rubocop.yml -A "$@"
    ;;
  setup)
    docker compose run --rm web bin/rails db:prepare db:seed
    ;;
  start)
    docker compose up --build
    ;;
  *)
    echo "Usage: ./goo {test|cop|setup|start} [arguments]"
    exit 1
    ;;
esac
